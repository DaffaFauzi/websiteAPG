{
  "name": "compro-ardana",
  "version": "0.9",
  "private": true,
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); const path=require('path'); const targets=['.next','.turbo']; for (const t of targets){ const p=path.join(process.cwd(),t); if (fs.existsSync(p)) fs.rmSync(p,{recursive:true,force:true}); } console.log('Cleaned: ' + targets.join(', '));\"",
    "predev": "npm run clean",
    "dev": "next dev --turbo",
    "dev:webpack": "next dev",
    "dev:clean": "npm run clean && next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "framer-motion": "^12.23.22",
    "gsap": "^3.14.2",
    "next": "^16.2.4",
    "react": "^19.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
